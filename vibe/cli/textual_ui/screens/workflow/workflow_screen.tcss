#workflow-screen {
    align: center middle;
}

#workflow-screen-content {
    width: 96%;
    max-width: 100;
    height: 90%;
    background: $surface;
    border: round $primary;
    border-title-color: $primary;
    border-title-style: bold;
    padding: 1 2 0 2;
}

.workflow-screen-status {
    height: auto;
    margin: 0 0 1 0;
    color: $text-muted;
}

#workflow-screen-tree {
    width: 100%;
    height: 1fr;
    border: none;
    padding: 0;
    scrollbar-gutter: stable;
}

.workflow-screen-log {
    height: 30%;
    border-top: solid $primary-background;
    background: $surface-darken-1;
    color: $text-muted;
}

.workflow-screen-help {
    height: auto;
    margin-top: 1;
    color: $text-muted;

    &:ansi {
        text-style: dim;
    }
}
